-- 7. year on Growth ( openings) --

WITH yearly_data AS (
    SELECT 
        `Year Opening` AS year_opening,
        COUNT(Restaurant_ID) AS total_restaurants
    FROM main_fact
    GROUP BY `Year Opening`
)

SELECT 
    year_opening,
    total_restaurants,

    LAG(total_restaurants) OVER (ORDER BY year_opening) AS prev_year,

    (total_restaurants - LAG(total_restaurants) OVER (ORDER BY year_opening)) AS growth

FROM yearly_data;


