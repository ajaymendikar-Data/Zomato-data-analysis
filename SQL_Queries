CREATE VIEW zomato_final AS
SELECT 
    m.Restaurant_id,
    m.RestaurantName,
    c.CountryName,
    m.City,
    m.Cuisines,
    m.Has_Table_booking,
    m.Has_Online_delivery,
    m.Votes,
    m.Rating,

 m.Date,

    YEAR(m.Date) AS Year,
    MONTH(m.Date) AS Month,
    MONTHNAME(m.Date) AS Month_Name,

    m.Average_Cost_for_two * cu.USD_Rate AS AvgCost_USD,

    CASE 
        WHEN (m.Average_Cost_for_two * cu.USD_Rate) < 10 THEN 'Low'
        WHEN (m.Average_Cost_for_two * cu.USD_Rate) BETWEEN 10 AND 30 THEN 'Medium'
        ELSE 'High'
    END AS Price_Bucket,

   CASE 
        WHEN m.Rating < 2 THEN '1-2'
        WHEN m.Rating < 3 THEN '2-3'
        WHEN m.Rating < 4 THEN '3-4'
        ELSE '4-5'
    END AS Rating_Bucket

FROM main_fact m
LEFT JOIN Country c 
ON m.CountryCode = c.Country_ID

LEFT JOIN Currency cu 
ON m.Currency = cu.Currency;

