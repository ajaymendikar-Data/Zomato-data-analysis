-- 1. Total Restaurants KPI--
SELECT 
COUNT(DISTINCT restaurant_id) AS total_restaurants
FROM main_fact;

-- 2. Restaurants by City

SELECT 
    city,
    COUNT(*) AS restaurant_count
FROM main_fact
GROUP BY city
ORDER BY restaurant_count DESC;

-- 3. Average Rating by City -- 

SELECT 
    city,
    AVG(rating) AS avg_rating
FROM main_fact
GROUP BY city
ORDER BY avg_rating DESC;


-- 4. Top 10 Restaurants by Rating -- 
SELECT 
    Restaurantname,
    city,
    rating
FROM main_fact
ORDER BY rating DESC
LIMIT 10;

-- 5. Cuisines Distribution --

SELECT 
    cuisines,
    COUNT(*) AS total
FROM main_fact
GROUP BY cuisines
ORDER BY total DESC;

-- 6. Year wise openings -- 

SELECT 
    YEAR(`date`) AS year,
    COUNT(*) AS new_restaurants
FROM main_fact
GROUP BY YEAR(`date`)
ORDER BY year;

